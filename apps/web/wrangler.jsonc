{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nesvo-web",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nesvo-web",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nesvo-web",
      "database_id": "8ad4dadd-72d5-4c1a-9f86-9b9b53fc4eec",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "NESVO_RELEASE_REPO": "dkveil/nesvo",
    "NESVO_RELEASE_API_ORIGIN": "https://api.github.com",
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "routes": [
    {
      "pattern": "nesvo.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
