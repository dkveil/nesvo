{
  "name": "@nesvo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate:local && next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "bun run db:migrate:local && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@nesvo/contracts": "workspace:*",
    "@opennextjs/cloudflare": "1.20.17",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "wrangler": "4.162.0"
  }
}
