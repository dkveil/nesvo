{
  "name": "@nesvo/host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/host.ts",
    "./mobile": "./src/mobile/gateway.ts",
    "./ssh-transport": "./src/ssh-transport.ts"
  },
  "bin": {
    "nesvo": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=node --outfile=dist/main.js && bun build src/mobile/gateway.ts --target=node --outfile=dist/mobile.js && bun build src/cli.ts --target=node --outfile=dist/cli.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nesvo/contracts": "workspace:*",
    "effect": "4.1.2",
    "ignore": "5.3.2",
    "js-yaml": "5.5.0",
    "smol-toml": "1.9.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  }
}
