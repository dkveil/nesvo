{
  "name": "@nesvo/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build"
  },
  "dependencies": {
    "@nanostores/react": "2.0.1",
    "@nesvo/brand": "*",
    "@tauri-apps/api": "2.12.4",
    "clsx": "2.1.1",
    "nanostores": "1.5.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "~6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
