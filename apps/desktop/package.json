{
  "name": "@nesvo/desktop",
  "version": "0.0.1-alpha.2",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "description": "Nesvo desktop prototype",
  "author": "Damian Kądziela",
  "scripts": {
    "dev": "node scripts/check-electron.mjs && bun run build:inbox-cli && electron-vite dev",
    "build": "bun run build:inbox-cli && electron-vite build",
    "build:inbox-cli": "bun build ../host/src/cli.ts --target=node --outfile=dist/inbox-cli/cli.mjs && node scripts/copy-inbox-launchers.mjs",
    "typecheck": "tsc --noEmit",
    "package:dir": "bun run build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@nesvo/contracts": "workspace:*",
    "@nesvo/host": "workspace:*",
    "@pierre/diffs": "1.6.4",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.7"
  }
}
