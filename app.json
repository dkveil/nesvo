{
  "expo": {
    "name": "nesvo",
    "slug": "reveil-development",
    "version": "0.1.0",
    "scheme": "pocketsessions",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.dkveil.pocketsessions",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Połącz się z komputerem w sieci lokalnej, aby korzystać z jego terminali.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.dkveil.pocketsessions",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Pozwól na skanowanie kodu QR, aby połączyć telefon z komputerem.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-font",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc10f67e-42f9-4878-af56-7eefd9ad89d9"
      }
    },
    "owner": "reveil-development"
  }
}
