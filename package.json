{
  "name": "pocket-sessions",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "buffer": "6.0.3",
    "expo": "~58.0.12",
    "expo-build-properties": "~58.0.10",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-dev-client": "~58.0.13",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.21",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "tweetnacl": "1.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "~19.3.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "tsx": "4.20.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --go",
    "terminal:build": "node scripts/build-terminal.mjs",
    "prestart": "npm run terminal:build",
    "preweb": "npm run terminal:build",
    "typecheck": "tsc --noEmit",
    "host": "cargo run --manifest-path host/Cargo.toml --",
    "host:lan": "cargo run --manifest-path host/Cargo.toml -- --lan",
    "host:test": "cargo test --manifest-path host/Cargo.toml",
    "test:web": "node tests/app.browser.mjs",
    "lint": "eslint src App.tsx index.ts",
    "test:live": "tsx tests/live.browser.ts",
    "test:client": "node --import tsx --test tests/client-replay.test.ts",
    "test:host": "node --import tsx --test tests/host.integration.test.ts",
    "test:terminal": "node src/terminal/tests/backpressure.browser.mjs"
  },
  "private": true,
  "license": "MIT",
  "description": "Mobile terminal sessions with an open-source Rust host"
}
