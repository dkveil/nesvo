{
  "name": "nesvo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "workspaces": [
    "apps/desktop",
    "apps/host",
    "apps/mobile-client",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "host": "bun run --cwd apps/host start",
    "build": "bun run --cwd apps/host build && bun run --cwd apps/desktop build",
    "typecheck": "bun run --filter '@nesvo/*' typecheck",
    "lint": "eslint apps/desktop/src apps/host/src apps/mobile-client/src packages/contracts/src scripts/desktop-smoke.mjs scripts/remote-smoke.mjs scripts/mobile-smoke.mjs apps/host/tests/*.mjs eslint.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --cwd apps/host build && node --test apps/host/tests/host.integration.test.mjs apps/host/tests/daemon.integration.test.mjs apps/host/tests/mobile.integration.test.mjs",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs",
    "smoke:mobile": "node scripts/mobile-smoke.mjs",
    "package:dir": "bun run --cwd apps/desktop package:dir",
    "mobile": "bun run --cwd apps/mobile-client start",
    "mobile:android": "bun run --cwd apps/mobile-client android",
    "mobile:typecheck": "bun run --cwd apps/mobile-client typecheck"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
