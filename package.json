{
  "name": "nesvo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Shared terminal sessions across desktop and mobile",
  "workspaces": [
    "apps/mobile",
    "packages/brand"
  ],
  "scripts": {
    "start": "npm run start --workspace @nesvo/mobile",
    "web": "npm run web --workspace @nesvo/mobile",
    "android": "npm run android --workspace @nesvo/mobile",
    "ios": "npm run ios --workspace @nesvo/mobile",
    "terminal:build": "npm run terminal:build --workspace @nesvo/mobile",
    "typecheck": "npm run typecheck --workspace @nesvo/mobile",
    "lint": "eslint apps/mobile/src --max-warnings 0",
    "format:check": "prettier --check \"apps/mobile/**/*.{ts,tsx,json,js,mjs}\" \"packages/**/*.{json,md}\" \"tests/*.{ts,mjs}\" \"scripts/**/*.{js,mjs,cjs,json}\" \"*.{json,js,md}\" \"docs/*.md\" \"apps/*/README.md\" \".github/workflows/*.yml\"",
    "test:client": "node --import tsx --test --test-timeout=180000 --test-force-exit tests/client-replay.test.ts tests/client-contract.test.ts tests/client-control.test.ts",
    "test:web": "node tests/app.browser.mjs",
    "test:create-session": "node --import tsx tests/create-session.browser.ts",
    "test:fleet": "node --import tsx tests/fleet.browser.ts",
    "test:live": "tsx tests/live.browser.ts",
    "test:host": "node --import tsx --test --test-timeout=180000 --test-force-exit tests/host.integration.test.ts",
    "test:sync": "node --import tsx --test --test-timeout=180000 --test-force-exit tests/sync.integration.test.ts",
    "test:tui": "node --import tsx --test --test-timeout=180000 --test-force-exit tests/tui.integration.test.ts",
    "test:terminal": "node apps/mobile/src/shared/terminal/__tests__/backpressure.browser.mjs",
    "host": "cargo run --manifest-path apps/host/Cargo.toml --",
    "host:lan": "cargo run --manifest-path apps/host/Cargo.toml -- --lan",
    "host:test": "cargo test --manifest-path apps/host/Cargo.toml --locked",
    "tui": "cargo run --manifest-path apps/tui/Cargo.toml --",
    "tui:test": "cargo test --manifest-path apps/tui/Cargo.toml --locked",
    "test:architecture": "node --test tests/architecture.test.mjs tests/contract-gates.test.mjs",
    "contract-gates": "node scripts/contract-gates.mjs",
    "test:packaging": "node --test tests/packaging.test.mjs",
    "test:brand": "node --import tsx --test tests/brand.test.mjs tests/logo-motion.test.ts",
    "test:brand:web": "node tests/brand.browser.mjs",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "dependencies:check": "npm run dependencies:check --workspace @nesvo/mobile",
    "export": "npm run export --workspace @nesvo/mobile"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "ajv": "^6.15.0",
    "esbuild": "0.25.12",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-boundaries": "7.2.0",
    "ignore": "5.3.2",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "tsx": "4.20.6",
    "ws": "8.22.0"
  }
}
