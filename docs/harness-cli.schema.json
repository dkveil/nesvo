{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nesvo:cli-query:v1",
  "title": "Nesvo headless query output v1",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": { "schemaVersion": { "const": 1 } },
  "oneOf": [
    {
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "receipt": { "$ref": "#/definitions/receipt" }
          }
        }
      }
    },
    {
      "required": ["ok", "data"],
      "properties": {
        "ok": { "const": true },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "const": "workflow" },
                "cursor": { "$ref": "#/definitions/cursor" }
              },
              "oneOf": [
                {
                  "required": [
                    "run",
                    "wakePolicy",
                    "notices",
                    "pendingCount",
                    "nextCursor",
                    "more"
                  ],
                  "properties": {
                    "run": {
                      "type": "object"
                    },
                    "wakePolicy": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "#/definitions/workflowWakePolicy"
                        }
                      ]
                    },
                    "notices": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "$ref": "#/definitions/workflowWakeNotice"
                      }
                    },
                    "pendingCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "nextCursor": {
                      "$ref": "#/definitions/cursor"
                    },
                    "more": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "required": ["run", "wakeBatch"],
                  "properties": {
                    "run": {
                      "type": "object"
                    },
                    "wakeBatch": {
                      "$ref": "#/definitions/workflowWakeBatch"
                    }
                  }
                },
                {
                  "required": ["run", "executor"],
                  "properties": {
                    "run": {
                      "type": "object"
                    },
                    "executor": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "#/definitions/workflowExecutor"
                        }
                      ]
                    }
                  }
                },
                {
                  "required": ["runs", "nextOffset"],
                  "properties": {
                    "runs": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "object",
                        "required": ["id", "title", "revision", "state"]
                      }
                    },
                    "nextOffset": { "type": ["integer", "null"] }
                  }
                },
                {
                  "required": ["run", "tasks"],
                  "properties": {
                    "launch": { "$ref": "#/definitions/workflowLaunch" },
                    "delivery": { "$ref": "#/definitions/workflowDelivery" },
                    "run": {
                      "type": "object",
                      "required": ["id", "title", "goal", "revision", "state", "taskResult"],
                      "properties": {
                        "id": { "type": "string" },
                        "title": { "type": "string" },
                        "goal": { "type": "string" },
                        "revision": { "type": "integer", "minimum": 1 },
                        "state": {
                          "enum": [
                            "draft",
                            "active",
                            "draining",
                            "drained",
                            "stopping",
                            "stopped",
                            "canceling",
                            "canceled",
                            "succeeded"
                          ]
                        },
                        "taskResult": { "enum": [null, "succeeded"] }
                      }
                    },
                    "tasks": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "key",
                          "title",
                          "instruction",
                          "dependencies",
                          "state",
                          "dependencyState",
                          "attempts",
                          "taskResult"
                        ],
                        "properties": {
                          "id": { "type": "string" },
                          "key": { "type": "string" },
                          "dependencies": { "type": "array", "items": { "type": "string" } },
                          "state": {
                            "enum": [
                              "planned",
                              "launching",
                              "launchFailed",
                              "launchUnknown",
                              "assigned",
                              "reported",
                              "succeeded",
                              "failed",
                              "stopped"
                            ]
                          },
                          "dependencyState": { "enum": ["ready", "waiting"] },
                          "attempts": { "type": "integer", "minimum": 0, "maximum": 16 },
                          "taskResult": { "enum": [null, "succeeded", "failed"] }
                        }
                      }
                    }
                  }
                },
                {
                  "required": ["run", "task", "attempt"],
                  "properties": {
                    "run": { "type": "object", "required": ["id", "title", "revision", "state"] },
                    "task": { "type": "object", "required": ["id", "key", "title", "instruction"] },
                    "attempt": { "$ref": "#/definitions/workflowAttempt" }
                  }
                },
                {
                  "required": ["run", "task", "attempts", "nextOffset"],
                  "properties": {
                    "run": { "type": "object", "required": ["id", "revision", "state"] },
                    "task": { "type": "object", "required": ["id", "spec"] },
                    "attempts": {
                      "type": "array",
                      "maxItems": 4,
                      "items": { "$ref": "#/definitions/workflowAttempt" }
                    },
                    "nextOffset": { "type": ["integer", "null"] }
                  }
                },
                {
                  "required": ["run", "task", "attempt", "decision"],
                  "properties": {
                    "run": {
                      "type": "object",
                      "required": ["id", "title", "revision", "state"]
                    },
                    "task": {
                      "type": "object",
                      "required": ["id"]
                    },
                    "attempt": {
                      "type": "object",
                      "required": ["id"]
                    },
                    "decision": {
                      "$ref": "#/definitions/workflowDecision"
                    }
                  }
                },
                {
                  "required": ["run", "decisions", "nextOffset"],
                  "properties": {
                    "run": {
                      "type": "object",
                      "required": ["id", "title", "revision", "state"]
                    },
                    "decisions": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "$ref": "#/definitions/workflowDecision"
                      }
                    },
                    "nextOffset": {
                      "type": ["integer", "null"]
                    }
                  }
                },
                {
                  "required": ["run", "control", "targets", "nextOffset"],
                  "properties": {
                    "run": { "type": "object", "required": ["id", "revision", "state"] },
                    "control": {
                      "type": "object",
                      "required": ["id", "kind", "state", "createdAt", "counts"],
                      "properties": {
                        "id": { "$ref": "#/definitions/id" },
                        "kind": { "enum": ["stop", "cancel"] },
                        "state": {
                          "enum": [
                            "dispatching",
                            "awaitingExit",
                            "blocked",
                            "unconfirmed",
                            "completed"
                          ]
                        },
                        "createdAt": { "$ref": "#/definitions/cursor" },
                        "counts": {
                          "type": "object",
                          "additionalProperties": { "type": "integer", "minimum": 0 }
                        }
                      }
                    },
                    "targets": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "required": [
                          "sessionId",
                          "attemptId",
                          "operationKey",
                          "phase",
                          "receiptId",
                          "code"
                        ],
                        "properties": {
                          "sessionId": { "$ref": "#/definitions/id" },
                          "attemptId": { "$ref": "#/definitions/id" },
                          "operationKey": { "type": "string", "minLength": 1, "maxLength": 128 },
                          "phase": {
                            "enum": [
                              "pending",
                              "dispatching",
                              "stopRequested",
                              "blocked",
                              "unknown",
                              "unavailable",
                              "exited"
                            ]
                          },
                          "receiptId": { "type": ["string", "null"] },
                          "code": { "type": ["string", "null"] }
                        }
                      }
                    },
                    "nextOffset": { "type": ["integer", "null"] }
                  }
                },
                {
                  "required": ["run", "policy"],
                  "properties": {
                    "run": { "type": "object", "required": ["id", "revision", "state"] },
                    "policy": { "$ref": "#/definitions/runBudget" }
                  }
                },
                {
                  "required": ["budget"],
                  "properties": {
                    "budget": {
                      "type": "object",
                      "required": ["revision", "limits"],
                      "properties": {
                        "revision": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "limits": {
                          "type": "object",
                          "required": ["maxSessions", "maxWorkers", "providers"],
                          "properties": {
                            "maxSessions": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 16
                            },
                            "maxWorkers": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 16
                            },
                            "providers": {
                              "type": "object",
                              "required": ["shell", "claude", "codex", "gemini"],
                              "properties": {
                                "shell": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 16
                                },
                                "claude": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 16
                                },
                                "codex": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 16
                                },
                                "gemini": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 16
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "required": ["run", "mailbox"],
                  "properties": {
                    "run": { "type": "object", "required": ["id", "title", "revision", "state"] },
                    "mailbox": {
                      "type": "object",
                      "required": ["runId", "recipientAttemptId"],
                      "properties": {
                        "runId": { "type": "string" },
                        "recipientAttemptId": { "type": ["string", "null"] }
                      }
                    }
                  },
                  "oneOf": [
                    {
                      "required": ["messages", "nextCursor", "headCursor", "pendingCount", "more"],
                      "properties": {
                        "messages": {
                          "type": "array",
                          "maxItems": 8,
                          "items": { "$ref": "#/definitions/workflowMessage" }
                        },
                        "nextCursor": { "$ref": "#/definitions/cursor" },
                        "headCursor": { "$ref": "#/definitions/cursor" },
                        "pendingCount": { "type": "integer", "minimum": 0 },
                        "more": { "type": "boolean" }
                      }
                    },
                    {
                      "required": ["message", "cursor"],
                      "properties": { "message": { "$ref": "#/definitions/workflowMessage" } }
                    },
                    {
                      "required": ["acknowledged", "cursor"],
                      "properties": {
                        "acknowledged": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 32,
                          "items": {
                            "type": "object",
                            "required": ["id", "ackedAt", "ackedBy"],
                            "properties": {
                              "id": { "type": "string" },
                              "ackedAt": { "$ref": "#/definitions/cursor" },
                              "ackedBy": { "type": "object", "required": ["role"] }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "object",
              "required": ["type", "receipt"],
              "properties": {
                "type": { "const": "operation" },
                "receipt": { "$ref": "#/definitions/receipt" },
                "cursor": { "$ref": "#/definitions/cursor" },
                "wait": {
                  "type": "object",
                  "required": ["until", "outcome", "reached"],
                  "properties": {
                    "until": { "enum": ["delivered", "received", "started", "settled"] },
                    "outcome": {
                      "enum": ["reached", "timeout", "failed", "unknown", "interrupted", "settled"]
                    },
                    "reached": { "type": "boolean" }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "events",
                "nextCursor",
                "headCursor",
                "floorCursor",
                "gap",
                "more",
                "health"
              ],
              "properties": {
                "type": { "const": "events" },
                "events": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "required": ["sequence", "sessionId", "kind", "at", "payload"],
                    "properties": {
                      "sequence": { "type": "integer", "minimum": 1 },
                      "sessionId": { "type": ["string", "null"] },
                      "kind": { "type": "string" },
                      "at": { "$ref": "#/definitions/cursor" },
                      "payload": { "type": "object" }
                    }
                  }
                },
                "nextCursor": { "$ref": "#/definitions/cursor" },
                "headCursor": { "$ref": "#/definitions/cursor" },
                "floorCursor": { "$ref": "#/definitions/cursor" },
                "gap": { "type": "boolean" },
                "more": { "type": "boolean" },
                "health": {
                  "type": "object",
                  "required": ["observationDrops", "writeFailures"],
                  "properties": {
                    "observationDrops": { "$ref": "#/definitions/cursor" },
                    "writeFailures": { "$ref": "#/definitions/cursor" }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "session"],
              "properties": {
                "type": { "const": "session" },
                "session": { "$ref": "#/definitions/session" }
              }
            },
            {
              "type": "object",
              "required": ["type", "sessions", "groups", "revision"],
              "properties": {
                "type": { "const": "sessions" },
                "sessions": { "type": "array", "items": { "$ref": "#/definitions/session" } },
                "groups": { "type": "array" },
                "revision": { "$ref": "#/definitions/cursor" }
              }
            },
            {
              "type": "object",
              "required": ["type", "sessionId", "cols", "rows", "page"],
              "properties": {
                "type": { "const": "sessionRead" },
                "sessionId": { "$ref": "#/definitions/id" },
                "cols": { "type": "integer", "minimum": 10, "maximum": 300 },
                "rows": { "type": "integer", "minimum": 2, "maximum": 150 },
                "page": { "$ref": "#/definitions/page" }
              }
            },
            {
              "type": "object",
              "required": ["type", "sessionId", "review"],
              "properties": {
                "type": { "const": "diff" },
                "sessionId": { "$ref": "#/definitions/id" },
                "review": {
                  "type": "object",
                  "required": ["directory", "scope", "files", "truncated"],
                  "properties": {
                    "directory": { "type": "string" },
                    "scope": { "enum": ["staged", "unstaged", "untracked"] },
                    "files": { "type": "array" },
                    "truncated": { "type": "boolean" }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "required": ["host", "programs", "providerVersions", "sessions"],
      "properties": {
        "host": {
          "type": "object",
          "required": ["id", "buildId", "version", "protocolVersion"],
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "buildId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
            "version": { "type": "string" },
            "protocolVersion": { "const": 2 }
          }
        },
        "programs": { "type": "array" },
        "providerVersions": { "type": "array" },
        "sessions": { "type": "array" }
      }
    }
  ],
  "definitions": {
    "runBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limits",
        "startedAt",
        "deadlineAt",
        "exhaustedAt",
        "timeState",
        "activeAttempts",
        "ownerDrain"
      ],
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxParallel", "maxAttemptsPerTask", "maxElapsedMs"],
          "properties": {
            "maxParallel": { "type": "integer", "minimum": 1, "maximum": 16 },
            "maxAttemptsPerTask": { "type": "integer", "minimum": 1, "maximum": 16 },
            "maxElapsedMs": { "type": ["integer", "null"], "minimum": 1000, "maximum": 604800000 }
          }
        },
        "startedAt": { "type": ["integer", "null"], "minimum": 0 },
        "deadlineAt": { "type": ["integer", "null"], "minimum": 0 },
        "exhaustedAt": { "type": ["integer", "null"], "minimum": 0 },
        "timeState": { "enum": ["notStarted", "untracked", "unlimited", "open", "exhausted"] },
        "activeAttempts": { "type": "integer", "minimum": 0 },
        "ownerDrain": { "type": "boolean" }
      }
    },
    "workflowDecision": {
      "type": "object",
      "required": [
        "id",
        "runId",
        "taskId",
        "attemptId",
        "question",
        "revision",
        "state",
        "audience",
        "askedBy",
        "createdAt",
        "expiresAt",
        "answer",
        "reason",
        "resolvedBy",
        "resolvedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "attemptId": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["pending", "answered", "canceled", "expired"]
        },
        "audience": {
          "enum": ["owner", "coordinator"]
        },
        "askedBy": {
          "type": "object"
        },
        "createdAt": {
          "$ref": "#/definitions/cursor"
        },
        "expiresAt": {
          "$ref": "#/definitions/cursor"
        },
        "answer": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "resolvedBy": {
          "type": ["object", "null"]
        },
        "resolvedAt": {
          "type": ["integer", "null"]
        }
      }
    },
    "workflowMessage": {
      "type": "object",
      "required": [
        "id",
        "sequence",
        "runId",
        "recipientAttemptId",
        "sender",
        "correlationId",
        "kind",
        "body",
        "payload",
        "createdAt",
        "ackedAt",
        "ackedBy"
      ],
      "properties": {
        "id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "runId": { "type": "string" },
        "recipientAttemptId": { "type": ["string", "null"] },
        "sender": {
          "type": "object",
          "required": ["role"],
          "properties": {
            "role": { "enum": ["owner", "coordinator", "worker"] },
            "sessionId": { "type": "string" },
            "attemptId": { "type": "string" }
          }
        },
        "correlationId": { "type": "string" },
        "kind": { "enum": ["note", "question", "error", "result", "decision"] },
        "body": { "type": "string", "maxLength": 4096 },
        "payload": { "type": ["object", "null"] },
        "createdAt": { "$ref": "#/definitions/cursor" },
        "ackedAt": { "type": ["integer", "null"] },
        "ackedBy": { "type": ["object", "null"] }
      }
    },
    "workflowLaunch": {
      "type": "object",
      "required": [
        "attemptId",
        "receiptId",
        "operationKey",
        "phase",
        "sessionId",
        "workspace",
        "createdAt",
        "code",
        "effectStarted",
        "directory"
      ],
      "properties": {
        "attemptId": { "type": "string" },
        "receiptId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "operationKey": { "type": "string", "maxLength": 128 },
        "phase": { "enum": ["accepted", "dispatching", "created", "failed", "unknown"] },
        "sessionId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "workspace": { "enum": ["shared", "worktree"] },
        "createdAt": { "$ref": "#/definitions/cursor" },
        "code": { "type": ["string", "null"] },
        "effectStarted": { "type": ["boolean", "null"] },
        "directory": { "type": ["string", "null"] }
      }
    },
    "workflowWakePolicy": {
      "type": "object",
      "required": [
        "id",
        "runId",
        "coordinator",
        "issuer",
        "enabled",
        "generation",
        "phase",
        "reason",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "runId": {
          "$ref": "#/definitions/id"
        },
        "coordinator": {
          "$ref": "#/definitions/id"
        },
        "issuer": {
          "$ref": "#/definitions/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": ["enabled", "waiting", "paused", "disabled", "completed"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "createdAt": {
          "$ref": "#/definitions/cursor"
        }
      }
    },
    "workflowWakeNotice": {
      "type": "object",
      "required": ["id", "sequence", "kind", "reference"],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "sequence": {
          "$ref": "#/definitions/cursor"
        },
        "kind": {
          "enum": ["result", "decision", "question", "error", "blocker"]
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "messageId": {
              "$ref": "#/definitions/id"
            },
            "messageSequence": {
              "$ref": "#/definitions/cursor"
            },
            "taskId": {
              "type": ["string", "null"]
            },
            "attemptId": {
              "type": ["string", "null"]
            },
            "decisionId": {
              "type": ["string", "null"]
            },
            "decisionState": {
              "type": ["string", "null"]
            },
            "sessionId": {
              "$ref": "#/definitions/id"
            },
            "signalRevision": {
              "type": "integer",
              "minimum": 1
            },
            "attention": {
              "type": "object",
              "required": ["priority", "reason", "blockedChildren", "processExited", "exitCode"],
              "additionalProperties": false,
              "properties": {
                "priority": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "reason": {
                  "type": ["string", "null"]
                },
                "blockedChildren": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 256
                },
                "processExited": {
                  "type": "boolean"
                },
                "exitCode": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            }
          },
          "anyOf": [
            {
              "required": ["messageId", "messageSequence"]
            },
            {
              "required": ["attemptId", "sessionId", "attention", "signalRevision"]
            }
          ]
        },
        "batchId": {
          "type": ["string", "null"]
        },
        "createdAt": {
          "$ref": "#/definitions/cursor"
        }
      }
    },
    "workflowWakeBatch": {
      "type": "object",
      "required": [
        "id",
        "policyId",
        "generation",
        "issuer",
        "phase",
        "reason",
        "createdAt",
        "notices",
        "receiptId",
        "operationKey",
        "native"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "policyId": {
          "$ref": "#/definitions/id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "issuer": {
          "$ref": "#/definitions/id"
        },
        "phase": {
          "enum": ["dispatching", "settled", "failed", "unknown", "interrupted"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "createdAt": {
          "$ref": "#/definitions/cursor"
        },
        "notices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/workflowWakeNotice"
          }
        },
        "receiptId": {
          "$ref": "#/definitions/id"
        },
        "operationKey": {
          "type": "string",
          "pattern": "^run-wake:[a-f0-9]{32}$"
        },
        "native": {
          "type": "object",
          "required": ["phase"],
          "properties": {
            "phase": {
              "type": "string"
            }
          }
        }
      }
    },
    "workflowExecutor": {
      "type": "object",
      "required": [
        "id",
        "runId",
        "spec",
        "issuer",
        "enabled",
        "generation",
        "phase",
        "reason",
        "taskId",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "runId": {
          "type": "string"
        },
        "spec": {
          "type": "object",
          "required": ["tasks", "retryFailed", "retryDelayMs", "readinessTimeoutMs"],
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": ["taskId", "profile"],
                "properties": {
                  "taskId": {
                    "type": "string"
                  },
                  "profile": {
                    "type": "object",
                    "required": ["program", "workspace"],
                    "properties": {
                      "program": {
                        "enum": ["claude", "codex", "gemini"]
                      },
                      "workspace": {
                        "enum": ["shared", "worktree"]
                      },
                      "name": {
                        "type": ["string", "null"]
                      },
                      "cwd": {
                        "type": ["string", "null"]
                      },
                      "harness": {
                        "type": ["boolean", "null"]
                      }
                    }
                  }
                }
              }
            },
            "retryFailed": {
              "type": "boolean"
            },
            "retryDelayMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 60000
            },
            "readinessTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            }
          }
        },
        "issuer": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "enum": ["enabled", "waiting", "blocked", "disabled", "paused", "completed", "scheduling"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "taskId": {
          "type": ["string", "null"]
        },
        "createdAt": {
          "$ref": "#/definitions/cursor"
        }
      }
    },
    "workflowDelivery": {
      "type": "object",
      "required": [
        "id",
        "attemptId",
        "phase",
        "blocker",
        "receiptId",
        "operationKey",
        "createdAt",
        "deadlineAt",
        "native"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "attemptId": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "queued",
            "dispatching",
            "sent",
            "failed",
            "paused",
            "expired",
            "canceled",
            "unknown"
          ]
        },
        "blocker": {
          "type": ["string", "null"]
        },
        "receiptId": {
          "type": ["string", "null"]
        },
        "operationKey": {
          "type": ["string", "null"]
        },
        "createdAt": {
          "$ref": "#/definitions/cursor"
        },
        "deadlineAt": {
          "$ref": "#/definitions/cursor"
        },
        "native": {
          "type": ["object", "null"],
          "properties": {
            "phase": {
              "type": "string"
            },
            "result": {
              "type": "object"
            }
          }
        }
      }
    },
    "workflowAttempt": {
      "type": "object",
      "required": ["id", "taskId", "ordinal", "sessionId", "state", "result", "validation"],
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 16 },
        "sessionId": { "type": "string" },
        "state": {
          "enum": [
            "launching",
            "launchFailed",
            "launchUnknown",
            "assigned",
            "reported",
            "succeeded",
            "failed",
            "stopped"
          ]
        },
        "result": { "type": ["object", "null"] },
        "launch": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/workflowLaunch" }] },
        "delivery": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/workflowDelivery" }] },
        "validation": { "type": ["object", "null"] }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["id", "operation", "phase", "sessionId", "result"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "operation": { "enum": ["create", "send", "interrupt", "stop"] },
        "phase": {
          "enum": [
            "accepted",
            "dispatching",
            "created",
            "failed",
            "unknown",
            "delivered",
            "received",
            "started",
            "waiting",
            "settled",
            "interrupted",
            "stopRequested",
            "stopped"
          ]
        },
        "sessionId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "result": { "type": "object" }
      }
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "cursor": { "type": "integer", "minimum": 0 },
    "session": {
      "type": "object",
      "required": [
        "id",
        "name",
        "cwd",
        "createdAt",
        "cols",
        "rows",
        "running",
        "groupId",
        "controllerId"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string" },
        "cwd": { "type": "string" },
        "createdAt": { "type": "string" },
        "cols": { "type": "integer", "minimum": 10, "maximum": 300 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 150 },
        "running": { "type": "boolean" },
        "program": { "enum": ["shell", "claude", "codex", "gemini"] },
        "groupId": { "type": ["string", "null"] },
        "controllerId": { "type": ["integer", "null"] },
        "uptimeSeconds": { "$ref": "#/definitions/cursor" }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "format",
        "data",
        "fromCursor",
        "nextCursor",
        "floorCursor",
        "headCursor",
        "gap",
        "more"
      ],
      "properties": {
        "format": { "const": "terminalReplay" },
        "data": { "type": "string", "maxLength": 8192 },
        "fromCursor": { "$ref": "#/definitions/cursor" },
        "nextCursor": { "$ref": "#/definitions/cursor" },
        "floorCursor": { "$ref": "#/definitions/cursor" },
        "headCursor": { "$ref": "#/definitions/cursor" },
        "gap": { "type": "boolean" },
        "more": { "type": "boolean" }
      }
    }
  }
}
