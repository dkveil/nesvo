{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nesvo:cli-query:v1",
  "title": "Nesvo headless query output v1",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": { "schemaVersion": { "const": 1 } },
  "oneOf": [
    {
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "receipt": { "$ref": "#/definitions/receipt" }
          }
        }
      }
    },
    {
      "required": ["ok", "data"],
      "properties": {
        "ok": { "const": true },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "const": "workflow" },
                "cursor": { "$ref": "#/definitions/cursor" }
              },
              "oneOf": [
                {
                  "required": ["runs", "nextOffset"],
                  "properties": {
                    "runs": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "object",
                        "required": ["id", "title", "revision", "state"]
                      }
                    },
                    "nextOffset": { "type": ["integer", "null"] }
                  }
                },
                {
                  "required": ["run", "tasks"],
                  "properties": {
                    "run": {
                      "type": "object",
                      "required": ["id", "title", "goal", "revision", "state", "taskResult"],
                      "properties": {
                        "id": { "type": "string" },
                        "title": { "type": "string" },
                        "goal": { "type": "string" },
                        "revision": { "type": "integer", "minimum": 1 },
                        "state": { "enum": ["draft", "active", "succeeded"] },
                        "taskResult": { "enum": [null, "succeeded"] }
                      }
                    },
                    "tasks": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "key",
                          "title",
                          "instruction",
                          "dependencies",
                          "state",
                          "dependencyState",
                          "attempts",
                          "taskResult"
                        ],
                        "properties": {
                          "id": { "type": "string" },
                          "key": { "type": "string" },
                          "dependencies": { "type": "array", "items": { "type": "string" } },
                          "state": {
                            "enum": ["planned", "assigned", "reported", "succeeded", "failed"]
                          },
                          "dependencyState": { "enum": ["ready", "waiting"] },
                          "attempts": { "type": "integer", "minimum": 0, "maximum": 16 },
                          "taskResult": { "enum": [null, "succeeded", "failed"] }
                        }
                      }
                    }
                  }
                },
                {
                  "required": ["run", "task", "attempt"],
                  "properties": {
                    "run": { "type": "object", "required": ["id", "title", "revision", "state"] },
                    "task": { "type": "object", "required": ["id", "key", "title", "instruction"] },
                    "attempt": { "$ref": "#/definitions/workflowAttempt" }
                  }
                },
                {
                  "required": ["run", "task", "attempts", "nextOffset"],
                  "properties": {
                    "run": { "type": "object", "required": ["id", "revision", "state"] },
                    "task": { "type": "object", "required": ["id", "spec"] },
                    "attempts": {
                      "type": "array",
                      "maxItems": 4,
                      "items": { "$ref": "#/definitions/workflowAttempt" }
                    },
                    "nextOffset": { "type": ["integer", "null"] }
                  }
                }
              ]
            },
            {
              "type": "object",
              "required": ["type", "receipt"],
              "properties": {
                "type": { "const": "operation" },
                "receipt": { "$ref": "#/definitions/receipt" },
                "cursor": { "$ref": "#/definitions/cursor" },
                "wait": {
                  "type": "object",
                  "required": ["until", "outcome", "reached"],
                  "properties": {
                    "until": { "enum": ["delivered", "received", "started", "settled"] },
                    "outcome": {
                      "enum": ["reached", "timeout", "failed", "unknown", "interrupted", "settled"]
                    },
                    "reached": { "type": "boolean" }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "events",
                "nextCursor",
                "headCursor",
                "floorCursor",
                "gap",
                "more",
                "health"
              ],
              "properties": {
                "type": { "const": "events" },
                "events": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "required": ["sequence", "sessionId", "kind", "at", "payload"],
                    "properties": {
                      "sequence": { "type": "integer", "minimum": 1 },
                      "sessionId": { "type": ["string", "null"] },
                      "kind": { "type": "string" },
                      "at": { "$ref": "#/definitions/cursor" },
                      "payload": { "type": "object" }
                    }
                  }
                },
                "nextCursor": { "$ref": "#/definitions/cursor" },
                "headCursor": { "$ref": "#/definitions/cursor" },
                "floorCursor": { "$ref": "#/definitions/cursor" },
                "gap": { "type": "boolean" },
                "more": { "type": "boolean" },
                "health": {
                  "type": "object",
                  "required": ["observationDrops", "writeFailures"],
                  "properties": {
                    "observationDrops": { "$ref": "#/definitions/cursor" },
                    "writeFailures": { "$ref": "#/definitions/cursor" }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "session"],
              "properties": {
                "type": { "const": "session" },
                "session": { "$ref": "#/definitions/session" }
              }
            },
            {
              "type": "object",
              "required": ["type", "sessions", "groups", "revision"],
              "properties": {
                "type": { "const": "sessions" },
                "sessions": { "type": "array", "items": { "$ref": "#/definitions/session" } },
                "groups": { "type": "array" },
                "revision": { "$ref": "#/definitions/cursor" }
              }
            },
            {
              "type": "object",
              "required": ["type", "sessionId", "cols", "rows", "page"],
              "properties": {
                "type": { "const": "sessionRead" },
                "sessionId": { "$ref": "#/definitions/id" },
                "cols": { "type": "integer", "minimum": 10, "maximum": 300 },
                "rows": { "type": "integer", "minimum": 2, "maximum": 150 },
                "page": { "$ref": "#/definitions/page" }
              }
            },
            {
              "type": "object",
              "required": ["type", "sessionId", "review"],
              "properties": {
                "type": { "const": "diff" },
                "sessionId": { "$ref": "#/definitions/id" },
                "review": {
                  "type": "object",
                  "required": ["directory", "scope", "files", "truncated"],
                  "properties": {
                    "directory": { "type": "string" },
                    "scope": { "enum": ["staged", "unstaged", "untracked"] },
                    "files": { "type": "array" },
                    "truncated": { "type": "boolean" }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "required": ["host", "programs", "providerVersions", "sessions"],
      "properties": {
        "host": {
          "type": "object",
          "required": ["id", "buildId", "version", "protocolVersion"],
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "buildId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
            "version": { "type": "string" },
            "protocolVersion": { "const": 2 }
          }
        },
        "programs": { "type": "array" },
        "providerVersions": { "type": "array" },
        "sessions": { "type": "array" }
      }
    }
  ],
  "definitions": {
    "workflowAttempt": {
      "type": "object",
      "required": ["id", "taskId", "ordinal", "sessionId", "state", "result", "validation"],
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 16 },
        "sessionId": { "type": "string" },
        "state": { "enum": ["assigned", "reported", "succeeded", "failed"] },
        "result": { "type": ["object", "null"] },
        "validation": { "type": ["object", "null"] }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["id", "operation", "phase", "sessionId", "result"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "operation": { "enum": ["create", "send", "interrupt", "stop"] },
        "phase": {
          "enum": [
            "accepted",
            "dispatching",
            "created",
            "failed",
            "unknown",
            "delivered",
            "received",
            "started",
            "waiting",
            "settled",
            "interrupted",
            "stopRequested",
            "stopped"
          ]
        },
        "sessionId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "result": { "type": "object" }
      }
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "cursor": { "type": "integer", "minimum": 0 },
    "session": {
      "type": "object",
      "required": [
        "id",
        "name",
        "cwd",
        "createdAt",
        "cols",
        "rows",
        "running",
        "groupId",
        "controllerId"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string" },
        "cwd": { "type": "string" },
        "createdAt": { "type": "string" },
        "cols": { "type": "integer", "minimum": 10, "maximum": 300 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 150 },
        "running": { "type": "boolean" },
        "program": { "enum": ["shell", "claude", "codex", "gemini"] },
        "groupId": { "type": ["string", "null"] },
        "controllerId": { "type": ["integer", "null"] },
        "uptimeSeconds": { "$ref": "#/definitions/cursor" }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "format",
        "data",
        "fromCursor",
        "nextCursor",
        "floorCursor",
        "headCursor",
        "gap",
        "more"
      ],
      "properties": {
        "format": { "const": "terminalReplay" },
        "data": { "type": "string", "maxLength": 8192 },
        "fromCursor": { "$ref": "#/definitions/cursor" },
        "nextCursor": { "$ref": "#/definitions/cursor" },
        "floorCursor": { "$ref": "#/definitions/cursor" },
        "headCursor": { "$ref": "#/definitions/cursor" },
        "gap": { "type": "boolean" },
        "more": { "type": "boolean" }
      }
    }
  }
}
